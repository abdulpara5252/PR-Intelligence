generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model PullRequest {
  id            String      @id @default(cuid())
  externalId    Int
  repoFullName  String
  title         String
  body          String?
  authorLogin   String
  state         String      // open | closed | merged
  isDraft       Boolean     @default(false)
  baseBranch    String
  headBranch    String
  additions     Int         @default(0)
  deletions     Int         @default(0)
  changedFiles  Int         @default(0)
  commits       Int         @default(0)
  htmlUrl       String
  createdAt     DateTime
  updatedAt     DateTime
  mergedAt      DateTime?
  closedAt      DateTime?
  syncedAt      DateTime    @default(now())

  metrics       PRMetrics?
  reviews       PRReview[]
  aiInsight     AIInsight?

  @@unique([externalId, repoFullName])
  @@index([authorLogin])
  @@index([state])
  @@index([repoFullName])
}

model PRMetrics {
  id                  String      @id @default(cuid())
  prId                String      @unique
  pr                  PullRequest @relation(fields: [prId], references: [id], onDelete: Cascade)
  cycleTimeHours      Float?
  reviewTimeHours     Float?
  timeToFirstReview   Float?
  reviewCount         Int         @default(0)
  approvalCount       Int         @default(0)
  commentCount        Int         @default(0)
  riskScore           Float?
  hasTestChanges      Boolean     @default(false)
  computedAt          DateTime    @default(now())
}

model PRReview {
  id              String      @id @default(cuid())
  prId            String
  pr              PullRequest @relation(fields: [prId], references: [id], onDelete: Cascade)
  externalId      BigInt
  reviewerLogin   String
  state           String      // APPROVED | CHANGES_REQUESTED | COMMENTED | DISMISSED
  body            String?
  submittedAt     DateTime

  @@unique([externalId, prId])
  @@index([reviewerLogin])
}

model Engineer {
  id                  String    @id @default(cuid())
  login               String    @unique
  name                String?
  avatarUrl           String?
  totalPRs            Int       @default(0)
  mergedPRs           Int       @default(0)
  totalReviews        Int       @default(0)
  avgCycleTimeHours   Float?
  avgRiskScore        Float?
  reviewParticipation Float?
  updatedAt           DateTime  @updatedAt
}

model AIInsight {
  id              String      @id @default(cuid())
  prId            String      @unique
  pr              PullRequest @relation(fields: [prId], references: [id], onDelete: Cascade)
  summary         String
  riskFlags       String[]
  model           String      @default("gpt-4o")
  promptTokens    Int?
  outputTokens    Int?
  generatedAt     DateTime    @default(now())
}

model SyncLog {
  id            String    @id @default(cuid())
  repoFullName  String
  syncType      String    // webhook | manual | cron
  status        String    // success | failed | partial
  prsSynced     Int       @default(0)
  error         String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
}
